# Copy thành /home/sociedu/sociedu-api/.env trên server — KHÔNG commit file .env thật.
APP_PORT=9992
SPRING_PROFILES_ACTIVE=prod
HIBERNATE_DDL_AUTO=none
SPRING_SQL_INIT_MODE=never
FLYWAY_ENABLED=true

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sociedu_db
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=

JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=7

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

APP_FRONTEND_BASE_URL=http://localhost:3000
APP_PUBLIC_API_BASE_URL=http://localhost:9992
APP_EMAIL_VERIFICATION_PAGE_URL=
APP_PASSWORD_RESET_PAGE_URL=

# WebSocket: mặc định /api/v1/ws + broker simple (application.yaml). Chỉ thêm APP_WS_BROKER_TYPE=relay khi scale nhiều pod.

VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=
VNP_FRONTEND_RETURN_URL=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
